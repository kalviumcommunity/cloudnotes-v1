[Unit]
Description=CloudNotes Flask App
After=network.target postgresql.service

[Service]
User=ojaschikara
WorkingDirectory=/home/ojaschikara/cloudnotes-v1
EnvironmentFile=/home/ojaschikara/cloudnotes-v1/.env
ExecStart=/home/ojaschikara/cloudnotes-v1/venv/bin/gunicorn --bind 0.0.0.0:5000 --timeout 60 app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
