[Unit]
Description=CloudNotes Flask app (gunicorn)
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/cloudnotes-v1
Environment="PATH=/home/ubuntu/cloudnotes-v1/venv/bin"
ExecStart=/home/ubuntu/cloudnotes-v1/venv/bin/gunicorn --bind 0.0.0.0:5000 app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
