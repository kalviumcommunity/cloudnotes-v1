# /etc/systemd/system/cloudnotes.service
# Runs CloudNotes under gunicorn as a managed, always-on service.
#   sudo cp deploy/cloudnotes.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now cloudnotes

[Unit]
Description=CloudNotes Flask app (gunicorn)
# Wait for networking and PostgreSQL before starting.
After=network.target postgresql.service
Wants=postgresql.service

[Service]
User=cloudnotes
Group=cloudnotes
WorkingDirectory=/home/cloudnotes/cloudnotes
# Real config (DATABASE_URL, SECRET_KEY) lives here, NOT in git.
EnvironmentFile=/home/cloudnotes/cloudnotes/.env
# Apply any pending migrations, then start gunicorn bound to all interfaces.
ExecStartPre=/home/cloudnotes/cloudnotes/venv/bin/python migrate.py
ExecStart=/home/cloudnotes/cloudnotes/venv/bin/gunicorn --workers 2 --bind 0.0.0.0:5000 --access-logfile - app:app
# Self-healing: restart whenever the process exits, 3 seconds later.
Restart=always
RestartSec=3

[Install]
# `systemctl enable` hooks the service into normal boot -> starts on boot.
WantedBy=multi-user.target
