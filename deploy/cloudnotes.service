[Unit]
Description=CloudNotes Flask application
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=cloudnotes
Group=cloudnotes
WorkingDirectory=/opt/cloudnotes
EnvironmentFile=/etc/cloudnotes/cloudnotes.env
ExecStart=/opt/cloudnotes/.venv/bin/gunicorn --bind 0.0.0.0:5000 app:app
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
