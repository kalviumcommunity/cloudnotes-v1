region              = "us-east-1"
localstack_endpoint = "http://localhost:4566"

vpc_cidr = "10.0.0.0/16"

web_subnet_cidr = "10.0.1.0/24"
app_subnet_cidr = "10.0.2.0/24"
db_subnet_cidr  = "10.0.3.0/24"

allowed_cidr = "0.0.0.0/0"

vpc_name        = "cloudnotes-vpc"
web_subnet_name = "cloudnotes-web-subnet"
app_subnet_name = "cloudnotes-app-subnet"
db_subnet_name  = "cloudnotes-db-subnet"

security_group_name          = "cloudnotes-app-firewall"
database_security_group_name = "cloudnotes-db-firewall"

http_port = 80
db_port   = 5432

ami_id        = "ami-12345678"
machine_type  = "t3.micro"
instance_name = "cloudnotes-app"

bucket_name = "cloudnotes-assets-example"

role_name = "cloudnotes-app-role"

db_subnet_group_name = "cloudnotes-db-subnet-group"
db_identifier        = "cloudnotes-db"
db_name              = "cloudnotes"
db_username          = "cloudnotes"

# Replace with a secure local value.
db_password = "CHANGE_ME"

db_instance_class    = "db.t3.micro"
db_allocated_storage = 20